# ==========================================
# AI TIKTOK VIDEO FACTORY CONFIGURATION
# ==========================================

# Tên kênh TikTok / YouTube / Reels
CHANNEL_NAME=AI Master

# AI Script Generation Provider: offline | openai | gemini
AI_PROVIDER=offline
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Text-to-Speech Provider: edge-tts | openai | elevenlabs | gtts
# Note: 'edge-tts' is FREE and works without an API key!
TTS_PROVIDER=edge-tts
TTS_API_KEY=

# Vietnamese Neural Voice ID
# Options for edge-tts:
# - vi-VN-HoaiMyNeural (Nữ miền Nam / Standard Female)
# - vi-VN-NamMinhNeural (Nam miền Bắc / Standard Male)
VOICE_ID=vi-VN-HoaiMyNeural

# Video Rendering Specifications
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Subtitle Styling
SUBTITLE_FONT_SIZE=68
SUBTITLE_FONT_COLOR=#FFFFFF
SUBTITLE_HIGHLIGHT_COLOR=#FFE600
SUBTITLE_BOTTOM_MARGIN=420

# Audio Settings
MUSIC_VOLUME=0.10
